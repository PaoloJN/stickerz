# Neon Postgres connection string. Unset = mock mode in dev (nothing stored), 503 on brand requests in production.
DATABASE_URL=
# GitHub token (fine-grained, Issues: write on the repo). Opens an issue per brand request and authenticates the star count.
GITHUB_TOKEN=
# owner/name to open brand-request issues in. Defaults to siteConfig.repo (PaoloJN/stickerz).
GITHUB_ISSUES_REPO=
